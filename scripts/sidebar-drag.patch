+const SIDEBAR_ORDER_KEY = "rohi-ab-sidebar-order-v1";
+const DEFAULT_SIDEBAR_ORDER: TabId[] = TAB_GROUPS.flatMap((group) => group.tabs.map((t) => t.id));
+
+function loadSidebarOrder(): TabId[] {
+  if (typeof window === "undefined") return DEFAULT_SIDEBAR_ORDER;
+  try {
+    const raw = window.localStorage.getItem(SIDEBAR_ORDER_KEY);
+    if (!raw) return [...DEFAULT_SIDEBAR_ORDER];
+    const parsed = JSON.parse(raw) as unknown;
+    if (!Array.isArray(parsed)) return [...DEFAULT_SIDEBAR_ORDER];
+    const known = new Set(DEFAULT_SIDEBAR_ORDER);
+    const ordered: TabId[] = [];
+    for (const id of parsed) {
+      if (typeof id === "string" && known.has(id as TabId) && !ordered.includes(id as TabId)) {
+        ordered.push(id as TabId);
+      }
+    }
+    for (const id of DEFAULT_SIDEBAR_ORDER) {
+      if (!ordered.includes(id)) ordered.push(id);
+    }
+    return ordered;
+  } catch {
+    return [...DEFAULT_SIDEBAR_ORDER];
+  }
+}
+
+function saveSidebarOrder(order: TabId[]) {
+  try {
+    window.localStorage.setItem(SIDEBAR_ORDER_KEY, JSON.stringify(order));
+  } catch {
+    /* ignore quota / private mode */
+  }
+}
+
+function orderTabGroups(order: TabId[]) {
+  const rank = new Map(order.map((id, index) => [id, index]));
+  return [...TAB_GROUPS].sort((a, b) => {
+    const ai = rank.get(a.tabs[0]?.id) ?? 999;
+    const bi = rank.get(b.tabs[0]?.id) ?? 999;
+    return ai - bi;
+  });
+}
+
+function renumberTabs(order: TabId[]): Record<TabId, string> {
+  const nums = { ...TAB_NUMBERS };
+  order.forEach((id, index) => {
+    nums[id] = String(index + 1).padStart(2, "0");
+  });
+  return nums;
+}
